{
  "name": "atelier-motors-api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "seed": "node seed/seed.js",
    "test": "node --test",
    "test:junit": "node --test --test-reporter=junit --test-reporter-destination=test-results/junit.xml",
    "test:coverage": "c8 --reporter=text --reporter=html --reporter=lcov node --test",
    "test:coverage:check": "c8 --check-coverage --lines 40 --functions 40 --branches 40 --statements 40 node --test"
  },
  "dependencies": {
    "@prometheus-io/client": "^0.16.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "c8": "^12.0.0",
    "nodemon": "^3.1.7",
    "supertest": "^7.0.0"
  }
}
